# Email Configuration (Mailbox 1)
PASS=your_email_password
SERVER=imap.yandex.ru
EMAIL=your_email@example.com

# Email Configuration (Mailbox 2)
EMAIL2=your_second_email@example.com
PASS2=your_second_email_password

# SMTP Configuration for Alerts
SMTP_USERNAME=your_smtp_username@example.com
SMTP_PASSWORD=your_smtp_password
TO_EMAIL=recipient1@example.com,recipient2@example.com

# AWS/MinIO Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Database Configuration (PostgreSQL)
# If these are set, the app will try to connect to PostgreSQL first
# If connection fails or variables are not set, it will fallback to SQLite
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=contractor_user
POSTGRES_PASSWORD=contractor_pass
POSTGRES_DB=contractor_db

# SQLite Database Path (used as fallback)
DB_PATH=message_ids.db
